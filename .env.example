# Working name: Aegis Lens (not final brand)

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:5454
NEXT_PUBLIC_SITE_NAME="Aegis Lens"

# Map provider (replace before going live; MapLibre+OSM works without)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Database — local docker-compose default
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis

# Redis — cache + ephemeral state
REDIS_URL=redis://localhost:6379

# Object storage — MinIO in dev, S3 in prod
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aegis
S3_SECRET_KEY=aegis-dev-only
S3_BUCKET=aegis-media

# Anthropic Claude — leave empty for copilot fake-mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Auth (placeholder — Sprint 2 swap for WorkOS / Clerk)
AUTH_SECRET=replace-me-in-real-env
