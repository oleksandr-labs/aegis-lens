{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@aegis/types": ["../../packages/types/src/index.ts"],
      "@aegis/types/*": ["../../packages/types/src/*.ts"],
      "@aegis/url-builder": ["../../packages/url-builder/src/index.ts"],
      "@aegis/i18n-config": ["../../packages/i18n-config/src/index.ts"],
      "@ua-map/copilot": ["../../services/copilot/src/index.ts"],
      "@ua-map/copilot/*": ["../../services/copilot/src/*.ts"],
      "@ua-map/layers": ["../../layers/src/index.ts"],
      "@ua-map/layers/*": ["../../layers/src/*.ts"],
      "@ua-map/travel-risk": ["../../services/travel-risk/src/index.ts"],
      "@ua-map/travel-risk/*": ["../../services/travel-risk/src/*.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
